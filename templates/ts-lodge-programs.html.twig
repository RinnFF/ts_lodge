{#
/**
 * @file
 * ts-lodge-programs.html.twig
 * The programme list rows and the add/edit form are loaded/swapped by HTMX.
 */
#}
<div class="tslo-wrapper">
<div class="tslo-container">
  <h2>Liste des programmes</h2>

  <div style="display:flex; gap:10px; margin-bottom:15px;">
    <button class="btn-add-program"
      hx-get="{{ path('ts_lodge.htmx.programme_form') }}"
      hx-target="#programFormContainer"
      hx-swap="innerHTML">+ Ajouter un programme</button>
    <a href="{{ path('ts_lodge.users') }}" class="btn-close-program">Fermer</a>
  </div>

  <table id="programsTable">
    <thead>
      <tr>
        <th>Catégorie</th>
        <th>Nom du programme</th>
        <th>Code</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody id="programsTableBody"
      hx-get="{{ path('ts_lodge.htmx.programmes_rows') }}"
      hx-trigger="load"
      hx-swap="outerHTML">
      <tr><td colspan="4">Chargement…</td></tr>
    </tbody>
  </table>

  <div id="programFormContainer" style="margin-top:20px;"></div>
</div>
</div>
