{#
/**
 * @file
 * ts-lodge-users.html.twig
 */
#}
<div class="tslo-wrapper">
<div class="tslo-container">
  <h2>Liste des usagers</h2>
  <a href="{{ path('ts_lodge.add_user') }}"  class="btn-add-user">+ Ajouter un usager</a>
  <a href="{{ path('ts_lodge.couches') }}"   class="btn-find-couch">Voir les couchages</a>
  <a href="{{ path('ts_lodge.programs') }}"  class="btn-programs">Programmes</a>

  <table id="usersTable">
    <thead id="usersTableHead">
      <tr>
        <th hx-get="{{ path('ts_lodge.htmx.users_rows') }}?sort=lastName"
            hx-target="#usersTableBody" hx-swap="outerHTML"
            style="cursor:pointer">Nom</th>
        <th hx-get="{{ path('ts_lodge.htmx.users_rows') }}?sort=firstName"
            hx-target="#usersTableBody" hx-swap="outerHTML"
            style="cursor:pointer">Prénom</th>
        <th>Genre</th>
        <th hx-get="{{ path('ts_lodge.htmx.users_rows') }}?sort=birthDate"
            hx-target="#usersTableBody" hx-swap="outerHTML"
            style="cursor:pointer">Date de naissance</th>
        <th>Âge</th>
        <th>Actions</th>
      </tr>
    </thead>
    {{ users_rows }}
  </table>
</div>
</div>
