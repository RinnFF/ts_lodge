{#
/**
 * @file
 * ts-lodge-users-rows.html.twig – HTMX partial: users <tbody>.
 * Variables: users (array with bookings[] per user), sort, dir
 */
#}
<tbody id="usersTableBody">
{% for user in users %}
<tr class="user-row">
  <td class="participant-num">{{ user.participantNumber }}</td>
  <td>{{ user.lastName }}</td>
  <td>{{ user.firstName }}</td>
  <td>{{ user.gender }}{% if user.isCouple %} <span class="couple-badge">&#10084;&#65039;</span>{% endif %}</td>
  <td>{{ user.birthDate }}</td>
  <td><span class="{{ user.ageClass }}">{{ user.ageStatus }}</span></td>
  <td class="user-actions">
    <a href="{{ path('ts_lodge.edit_user', {id: user.id}) }}" class="btn-edit">Modifier usager</a>
    <a href="{{ path('ts_lodge.book_user', {userId: user.id}) }}" class="btn-book">Ajouter un séjour</a>
  </td>
</tr>
<tr class="stays-row">
  <td colspan="7">
    <details class="stays-accordion">
      <summary class="stays-summary">
        {%- set nb = user.bookings|length -%}
        {%- if nb == 0 -%}Aucun séjour
        {%- elseif nb == 1 -%}1 séjour
        {%- else -%}{{ nb }} séjours
        {%- endif -%}
        {%- set hasActive = false -%}
        {%- for bk in user.bookings -%}{%- if bk.status == 'current' -%}{%- set hasActive = true -%}{%- endif -%}{%- endfor -%}
        {% if hasActive %}&ensp;<span class="stay-badge stay-badge--current">En cours</span>{% endif %}
      </summary>
      {% if user.bookings %}
      <div class="stays-list">
        {% for bk in user.bookings %}
        <div class="stay stay--{{ bk.status }}">
          <span class="stay-prog">{{ bk.programmeCode ?: '—' }}</span>
          <span class="stay-dates">{{ bk.arrivalDate }} → {{ bk.departureDate }}</span>
          <span class="stay-couch">🛏 {{ bk.couch ?: 'Lit non attribué' }}</span>
          <a href="{{ path('ts_lodge.book_user', {userId: user.id}) }}?booking={{ bk.id }}"
             class="btn-edit-res">Modifier le séjour</a>
        </div>
        {% endfor %}
      </div>
      {% endif %}
    </details>
  </td>
</tr>
{% else %}
<tr><td colspan="7">Aucun usager enregistré.</td></tr>
{% endfor %}
</tbody>
