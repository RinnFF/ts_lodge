{#
/**
 * @file
 * ts-lodge-find-couch.html.twig
 * Variables: userId, bookingId
 * Couch buttons are loaded by HTMX from the find_couch_buttons endpoint.
 */
#}
<div class="tslo-wrapper">
<div class="tslo-container">
  <h2>Choisir un couchage</h2>

  <div id="couchButtonsContainer"
    hx-get="{{ path('ts_lodge.htmx.find_couch_buttons', {userId: userId, bookingId: bookingId}) }}"
    hx-trigger="load"
    hx-swap="innerHTML">
    <p>Chargement des couchages…</p>
  </div>

  <div style="margin-top:20px;">
    <a href="{{ path('ts_lodge.users') }}" class="btn-close">Fermer</a>
  </div>
</div>
</div>
